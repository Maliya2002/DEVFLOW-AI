# Copy to apps/api/.env. Keep credentials out of Git and chat.
PORT=3001
HOST=127.0.0.1
# Keep disabled until a verified sender and fragment-consuming landing page are ready.
EMAIL_VERIFICATION_ENABLED=false
# RESEND_API_KEY=SET_ONLY_IN_LOCAL_ENV_OR_SECRET_STORE
# VERIFICATION_EMAIL_FROM=accounts@YOUR_VERIFIED_DOMAIN
# Registration is disabled until both settings are supplied.
# APP_ORIGIN=http://127.0.0.1:3000
# AUTH_RATE_LIMIT_SECRET=GENERATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
# Neon Connect dialog: pooled URL for runtime, direct URL for migrations.
# Replace every placeholder before use. Remote TLS certificates are verified.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
# DIRECT_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=verify-full
