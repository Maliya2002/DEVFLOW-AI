{
  "name": "@devflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "npm run db:generate && tsc --project tsconfig.json",
    "build": "npm run db:generate && tsc --project tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "npm run build && node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "db:generate": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js generate",
    "db:validate": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js validate",
    "db:check": "npm run build && node --env-file-if-exists=.env dist/database/check.js",
    "db:deploy": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node --env-file-if-exists=.env ../../node_modules/prisma/build/index.js migrate status"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@zxcvbn-ts/language-common": "4.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1"
  }
}
