generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum OrganizationRole {
  ADMIN
  HR
  PROJECT_MANAGER
  EMPLOYEE
  VIEWER
}

model User {
  id                 String                   @id @default(uuid()) @db.Uuid
  normalizedEmail    String                   @unique @db.VarChar(254)
  displayName        String                   @db.VarChar(100)
  status             UserStatus               @default(ACTIVE)
  emailVerifiedAt    DateTime?                @db.Timestamptz(3)
  passwordHash       String?                  @db.Text
  authVersion        Int                      @default(0)
  createdAt          DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                 @updatedAt @db.Timestamptz(3)
  memberships        Membership[]
  securityEvents     AuthSecurityEvent[]
  sessions           AuthSession[]
  verificationTokens EmailVerificationToken[]
}

model EmailVerificationToken {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  email         String    @db.VarChar(254)
  purpose       String    @default("EMAIL_VERIFICATION") @db.VarChar(32)
  tokenDigest   String    @unique @db.VarChar(64)
  createdAt     DateTime  @db.Timestamptz(3)
  expiresAt     DateTime  @db.Timestamptz(3)
  consumedAt    DateTime? @db.Timestamptz(3)
  invalidatedAt DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([invalidatedAt])
}

model AuthRateBucket {
  keyDigest String   @id @db.VarChar(64)
  hits      Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

model AuthSecurityEvent {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  action        String   @db.VarChar(40)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  user          User?    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  targetId      String?  @db.Uuid
  correlationId String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AuthSession {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  tokenDigest        String    @unique @db.VarChar(64)
  authVersionAtIssue Int
  rememberMe         Boolean   @default(false)
  createdAt          DateTime  @db.Timestamptz(3)
  lastSeenAt         DateTime  @db.Timestamptz(3)
  idleExpiresAt      DateTime  @db.Timestamptz(3)
  absoluteExpiresAt  DateTime  @db.Timestamptz(3)
  reauthenticatedAt  DateTime  @db.Timestamptz(3)
  revokedAt          DateTime? @db.Timestamptz(3)
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([userId, createdAt])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
  @@index([revokedAt])
}

model Organization {
  id                String             @id @default(uuid()) @db.Uuid
  name              String             @db.VarChar(100)
  status            OrganizationStatus @default(ACTIVE)
  ownerMembershipId String             @db.Uuid
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)
  owner             Membership         @relation("OrganizationOwner", fields: [id, ownerMembershipId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  memberships       Membership[]       @relation("OrganizationMembers")
}

model Membership {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  userId             String                  @db.Uuid
  status             MembershipStatus        @default(ACTIVE)
  createdAt          DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @db.Timestamptz(3)
  organization       Organization            @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  ownedOrganizations Organization[]          @relation("OrganizationOwner")
  roles              OrganizationRoleGrant[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
}

model OrganizationRoleGrant {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  membershipId   String           @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  membership     Membership       @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([organizationId, membershipId, role])
}
