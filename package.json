{
  "name": "devflow-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Remote engineering team platform",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.18.0 <12"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build:api": "npm run build --workspace @devflow/api",
    "start:api": "npm run start --workspace @devflow/api",
    "test:api": "npm run test --workspace @devflow/api",
    "dev:web": "npm run dev --workspace @devflow/web",
    "build:web": "npm run build --workspace @devflow/web",
    "start:web": "npm run start --workspace @devflow/web",
    "test:web": "npm run test:e2e --workspace @devflow/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "verify": "npm run check && npm run test:api && npm run build:web && npm run test:web",
    "db:generate": "npm run db:generate --workspace @devflow/api",
    "db:validate": "npm run db:validate --workspace @devflow/api",
    "db:check": "npm run db:check --workspace @devflow/api",
    "db:deploy": "npm run db:deploy --workspace @devflow/api",
    "db:status": "npm run db:status --workspace @devflow/api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
