{
  "name": "devflow-ai",
  "version": "0.0.0",
  "private": true,
  "description": "Remote engineering team platform",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.18.0 <12"
  },
  "workspaces": ["apps/*"],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "build:api": "npm run build --workspace @devflow/api",
    "start:api": "npm run start --workspace @devflow/api",
    "test:api": "npm run test --workspace @devflow/api"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
